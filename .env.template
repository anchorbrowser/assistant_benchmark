# Copy to .env (gitignored) and fill in what you need.
#   cp .env.template .env
# The runner loads .env automatically. Existing shell exports win.

# ---------------------------------------------------------------------------
# World
# ---------------------------------------------------------------------------
# Public URL of the world when the assistant fetches pages itself
# (channel / manual). Leave unset for --mode api (localhost is fine).
# ABENCH_BASE=https://your-tunnel.ngrok-free.dev

# ---------------------------------------------------------------------------
# Cursor automation webhook  (--mode channel --channel cursor)
# ---------------------------------------------------------------------------
# Two different fields on the same webhook screen. Do not mix them up.
#
#   Webhook  = the POST URL  →  ABENCH_CURSOR_WEBHOOK  (or pass --to)
#   key      = the crsr_… secret  →  ABENCH_CURSOR_TOKEN
#              sent as  Authorization: Bearer <token>
#
# Create one under Cursor Automations → webhook. If this token has ever been
# pasted into chat, rotate it in that UI and put the new value here.
ABENCH_CURSOR_WEBHOOK=https://api2.cursor.sh/automations/webhook/<id>
ABENCH_CURSOR_TOKEN=crsr_replace_me

# Seconds to keep listening on /abench/reply after the world goes quiet.
# The agent often acts first and writes its summary ~40s later.
# ABENCH_REPLY_GRACE=150

# ---------------------------------------------------------------------------
# API keys  (--mode api, and the written-quality judge)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# XAI_API_KEY=xai-...                 # console.x.ai; GROK_API_KEY also works

# ---------------------------------------------------------------------------
# Other channels (optional)
# ---------------------------------------------------------------------------
# ABENCH_WEBHOOK_URL=https://your-bot.example/inbox
# ABENCH_WEBHOOK_POLL=https://your-bot.example/outbox

# ABENCH_EMAIL_USER=
# ABENCH_EMAIL_PASS=
# ABENCH_SMTP_HOST=
# ABENCH_SMTP_PORT=587
# ABENCH_IMAP_HOST=

# Browser channel selectors, if probe shows 0 matches
# ABENCH_INPUT_SEL=div[contenteditable="true"]
# ABENCH_MSG_SEL=[data-message-author-role="assistant"]
# ABENCH_HEADLESS=1
